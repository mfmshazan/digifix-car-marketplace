{
  "name": "delivery-partner-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --go --port 8082 --max-workers 2",
    "start:dev-client": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --dev-client --port 8082 --max-workers 2",
    "start:expo-go": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --go --port 8082 --max-workers 2",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/android-dev.ps1 --port 8082",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@clerk/expo": "^4.2.5",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
