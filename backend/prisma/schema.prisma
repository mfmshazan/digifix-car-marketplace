generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  password         String?
  name             String?
  phone            String?
  avatar           String?
  role             UserRole       @default(CUSTOMER)
  authProvider     AuthProvider   @default(EMAIL)
  googleId         String?        @unique
  isVerified       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  status           UserStatus     @default(ACTIVE)
  stripeAccountId  String?        @unique
  deliveryStatus   String?        @default("offline")
  rating           Float          @default(5.0)
  total_deliveries Int            @default(0)
  vehicleNumber    String?
  vehicleType      String?
  total_reviews    Int            @default(0)

  // Manager / Salesman hierarchy.
  // A SALESMAN belongs to a SHOP_MANAGER (managerId set). A SHOP_MANAGER has
  // managerId = null and is the store/catalog/wallet owner salesmen operate under.
  managerId        String?
  manager          User?          @relation("ManagerSalesmen", fields: [managerId], references: [id], onDelete: SetNull)
  salesmen         User[]         @relation("ManagerSalesmen")

  addresses        Address[]
  carParts         CarPart[]      @relation("SellerCarParts")
  cart             CartItem[]
  orders           Order[]        @relation("CustomerOrders")
  salesOrders      Order[]        @relation("SalesmanOrders")
  products         Product[]      @relation("SalesmanProducts")
  reviews          Review[]
  reviewReplies    ReviewReply[]
  store            Store?
  wallet           Wallet?
  wishlist         WishlistItem[]

  @@index([managerId])
}

model Wallet {
  id                   String              @id @default(cuid())
  balance              Float               @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  receivedTransactions WalletTransaction[] @relation("ReceivedTransactions")
  sentTransactions     WalletTransaction[] @relation("SentTransactions")
  debtReceipts         DebtReceipt[]
}

model WalletTransaction {
  id                  String              @id @default(cuid())
  amount              Float
  type                TransactionType
  senderWalletId      String?
  receiverWalletId    String?
  codSettlementStatus CodSettlementStatus @default(NOT_APPLICABLE)
  description         String?
  createdAt           DateTime            @default(now())
  orderId             String?
  sourceRef           String?             @unique
  order               Order?              @relation(fields: [orderId], references: [id])
  receiverWallet      Wallet?             @relation("ReceivedTransactions", fields: [receiverWalletId], references: [id])
  senderWallet        Wallet?             @relation("SentTransactions", fields: [senderWalletId], references: [id])

  @@index([senderWalletId])
  @@index([receiverWalletId])
  @@index([type])
  @@index([orderId])
}

model Store {
  id              String    @id @default(cuid())
  name            String
  description     String?
  logo            String?
  banner          String?
  address         String?
  pickupAddress   String?
  pickupLatitude  Float?
  pickupLongitude Float?
  phone           String?
  rating          Float     @default(0)
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  ownerId         String    @unique
  totalReviews    Int       @default(0)
  products        Product[]
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Product {
  id                 String                 @id @default(cuid())
  name               String
  description        String?
  price              Float
  discountPrice      Float?
  sku                String?                @unique
  stock              Int                    @default(0)
  images             String[]
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  categoryId         String?
  salesmanId         String
  storeId            String?
  vehicleModelId     String?
  averageRating      Float                  @default(0)
  totalReviews       Int                    @default(0)
  approvalStatus     ItemApprovalStatus     @default(PENDING)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  category           Category?              @relation(fields: [categoryId], references: [id])
  salesman           User                   @relation("SalesmanProducts", fields: [salesmanId], references: [id], onDelete: Cascade)
  store              Store?                 @relation(fields: [storeId], references: [id])
  vehicleModel       VehicleModel?          @relation(fields: [vehicleModelId], references: [id], onDelete: SetNull)
  compatibleVehicles VehicleCompatibility[]
  compatibleModels   VehicleModel[]         @relation("ProductCompatibleModels")
  wishlistItems      WishlistItem[]

  @@index([categoryId])
  @@index([salesmanId])
  @@index([storeId])
  @@index([vehicleModelId])
  @@index([name])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  icon        String?
  image       String?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  carParts    CarPart[]
  parent      Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  products    Product[]

  @@index([parentId])
}

model VehicleCompatibility {
  id        String  @id @default(cuid())
  make      String
  model     String
  yearStart Int
  yearEnd   Int?
  engine    String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([make, model])
  @@index([productId])
}

model Address {
  id        String   @id @default(cuid())
  label     String?
  street    String
  city      String
  state     String
  postalCode String
  country   String   @default("Sri Lanka")
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  itemType  String   @default("PRODUCT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  productId String?
  carPartId String?
  carPart   CarPart? @relation(fields: [carPartId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, carPartId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  productId String?
  carPartId String?
  itemType  String   @default("PRODUCT")
  carPart   CarPart? @relation(fields: [carPartId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, carPartId])
  @@index([userId])
}

model Order {
  id                 String              @id @default(cuid())
  orderNumber        String              @unique @default(cuid())
  status             OrderStatus         @default(PENDING)
  paymentStatus      PaymentStatus       @default(PENDING)
  paymentMethod      String?
  subtotal           Float
  deliveryFee        Float               @default(0)
  discount           Float               @default(0)
  total              Float
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customerId         String
  salesmanId         String
  addressId          String?
  deliveryAddress    String?
  deliveryLatitude   Float?
  deliveryLongitude  Float?
  cancellationReason String?
  serviceCharge      Float               @default(0)
  riderDeliveryJobs  DeliveryJob[]
  address            Address?            @relation(fields: [addressId], references: [id])
  customer           User                @relation("CustomerOrders", fields: [customerId], references: [id])
  salesman           User                @relation("SalesmanOrders", fields: [salesmanId], references: [id])
  items              OrderItem[]
  tracking           OrderTracking[]
  reviews            Review[]
  walletTransactions WalletTransaction[]

  @@index([customerId])
  @@index([salesmanId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int
  price     Float
  total     Float
  itemName  String?
  itemType  String   @default("PRODUCT")
  createdAt DateTime @default(now())
  orderId   String
  productId String?
  carPartId String?
  carPart   CarPart? @relation(fields: [carPartId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([carPartId])
}

model OrderTracking {
  id          String      @id @default(cuid())
  status      OrderStatus
  description String?
  location    String?
  createdAt   DateTime    @default(now())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Review {
  id         String           @id @default(cuid())
  rating     Int
  title      String?
  comment    String?
  images     String[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  userId     String
  orderId    String
  status     ReviewStatus     @default(PUBLISHED)
  targetId   String
  targetType ReviewTargetType
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies    ReviewReply[]

  @@unique([orderId, targetId, targetType])
  @@index([targetId])
  @@index([rating])
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  sellerId  String
  replyText String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([sellerId])
}

model Car {
  id          String    @id @default(cuid())
  numberPlate String    @unique
  make        String
  model       String
  year        Int
  engineType  String?
  color       String?
  vinNumber   String?   @unique
  description String?
  images      String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  parts       CarPart[]

  @@index([numberPlate])
  @@index([make, model])
  @@index([year])
}

model CarPart {
  id             String             @id @default(cuid())
  name           String
  description    String?
  partNumber     String?
  price          Float
  discountPrice  Float?
  stock          Int                @default(0)
  condition      String             @default("NEW")
  images         String[]
  isActive       Boolean            @default(true)
  averageRating  Float              @default(0)
  totalReviews   Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  carId          String
  categoryId     String
  sellerId       String
  approvalStatus ItemApprovalStatus @default(PENDING)
  car            Car                @relation(fields: [carId], references: [id], onDelete: Cascade)
  category       Category           @relation(fields: [categoryId], references: [id])
  seller         User               @relation("SellerCarParts", fields: [sellerId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]

  @@index([carId])
  @@index([categoryId])
  @@index([sellerId])
  @@index([name])
  @@index([partNumber])
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Rider {
  id                    Int                        @id @default(autoincrement())
  email                 String                     @unique @db.VarChar(255)
  passwordHash          String                     @map("password_hash") @db.VarChar(255)
  fullName              String                     @map("full_name") @db.VarChar(255)
  phone                 String                     @db.VarChar(20)
  vehicleType           String?                    @map("vehicle_type") @db.VarChar(50)
  vehicleNumber         String?                    @map("vehicle_number") @db.VarChar(50)
  profilePhotoUrl       String?                    @map("profile_photo_url")
  bio                   String?
  address               String?
  emergencyContactName  String?                    @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactPhone String?                    @map("emergency_contact_phone") @db.VarChar(20)
  pushToken             String?                    @map("push_token")
  pushPlatform          String?                    @map("push_platform") @db.VarChar(20)
  pushTokenUpdatedAt    DateTime?                  @map("push_token_updated_at")
  status                String                     @default("offline") @db.VarChar(20)
  currentLatitude       Decimal?                   @map("current_latitude") @db.Decimal(10, 8)
  currentLongitude      Decimal?                   @map("current_longitude") @db.Decimal(11, 8)
  rating                Decimal                    @default(0.00) @db.Decimal(3, 2)
  totalDeliveries       Int                        @default(0) @map("total_deliveries")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @default(now()) @map("updated_at")
  totalReviews          Int                        @default(0) @map("total_reviews")
  jobs                  DeliveryJob[]
  offers                DeliveryOffer[]
  tracking              DeliveryTracking[]
  availabilitySessions  RiderAvailabilitySession[]
  refreshTokens         RiderToken[]

  @@index([email], map: "idx_rider_partners_email")
  @@index([status], map: "idx_rider_partners_status")
}

model RiderAvailabilitySession {
  id        Int       @id @default(autoincrement())
  partnerId Int       @map("partner_id")
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  endReason String?   @map("end_reason") @db.VarChar(50)
  partner   Rider     @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, startedAt], map: "idx_rider_availability_partner_started")
}

model RiderToken {
  id        Int      @id @default(autoincrement())
  partnerId Int      @map("partner_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  partner   Rider    @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([token], map: "idx_rider_refresh_tokens_token")
  @@index([partnerId], map: "idx_rider_refresh_tokens_partner")
}

model DeliveryJob {
  id                     Int                @id @default(autoincrement())
  partnerId              Int?               @map("partner_id")
  marketplaceOrderId     String?            @map("marketplace_order_id")
  orderNumber            String             @unique @map("order_number") @db.VarChar(100)
  customerName           String             @map("customer_name") @db.VarChar(255)
  customerPhone          String             @map("customer_phone") @db.VarChar(20)
  pickupAddress          String             @map("pickup_address")
  pickupLatitude         Decimal            @map("pickup_latitude") @db.Decimal(10, 8)
  pickupLongitude        Decimal            @map("pickup_longitude") @db.Decimal(11, 8)
  pickupContactName      String?            @map("pickup_contact_name") @db.VarChar(255)
  pickupContactPhone     String?            @map("pickup_contact_phone") @db.VarChar(20)
  dropoffAddress         String             @map("dropoff_address")
  dropoffLatitude        Decimal            @map("dropoff_latitude") @db.Decimal(10, 8)
  dropoffLongitude       Decimal            @map("dropoff_longitude") @db.Decimal(11, 8)
  distanceKm             Decimal?           @map("distance_km") @db.Decimal(6, 2)
  paymentAmount          Decimal            @map("payment_amount") @db.Decimal(10, 2)
  itemsDescription       String?            @map("items_description")
  specialInstructions    String?            @map("special_instructions")
  status                 String             @default("pending") @db.VarChar(30)
  createdAt              DateTime           @default(now()) @map("created_at")
  assignedAt             DateTime?          @map("assigned_at")
  acceptedAt             DateTime?          @map("accepted_at")
  arrivedAtPickupAt      DateTime?          @map("arrived_at_pickup_at")
  pickedUpAt             DateTime?          @map("picked_up_at")
  arrivedAtDropoffAt     DateTime?          @map("arrived_at_dropoff_at")
  deliveredAt            DateTime?          @map("delivered_at")
  failedAt               DateTime?          @map("failed_at")
  updatedAt              DateTime           @default(now()) @map("updated_at")
  packageNotes           String?            @map("package_notes")
  packageType            String?            @map("package_type") @db.VarChar(80)
  packageWeight          Decimal?           @map("package_weight") @db.Decimal(8, 2)
  paymentType            String             @default("PREPAID") @map("payment_type") @db.VarChar(30)
  proofPhotoUrl          String?            @map("proof_photo_url")
  proofSignatureData     String?            @map("proof_signature_data")
  proofRecipientName     String?            @map("proof_recipient_name") @db.VarChar(255)
  proofNotes             String?            @map("proof_notes")
  proofDeliveryLatitude  Decimal?           @map("proof_delivery_latitude") @db.Decimal(10, 8)
  proofDeliveryLongitude Decimal?           @map("proof_delivery_longitude") @db.Decimal(11, 8)
  proofCreatedAt         DateTime?          @map("proof_created_at")
  marketplaceOrder       Order?             @relation(fields: [marketplaceOrderId], references: [id])
  partner                Rider?             @relation(fields: [partnerId], references: [id])
  offers                 DeliveryOffer[]
  tracking               DeliveryTracking[]

  @@index([status], map: "idx_rider_jobs_status")
  @@index([partnerId], map: "idx_rider_jobs_partner")
  @@index([orderNumber], map: "idx_rider_jobs_order_number")
  @@index([marketplaceOrderId], map: "idx_rider_jobs_marketplace_order")
}

model DeliveryTracking {
  id         Int         @id @default(autoincrement())
  jobId      Int         @map("job_id")
  partnerId  Int         @map("partner_id")
  latitude   Decimal     @db.Decimal(10, 8)
  longitude  Decimal     @db.Decimal(11, 8)
  accuracy   Decimal?    @db.Decimal(6, 2)
  speed      Decimal?    @db.Decimal(6, 2)
  heading    Decimal?    @db.Decimal(5, 2)
  recordedAt DateTime    @default(now()) @map("recorded_at")
  job        DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partner    Rider       @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "idx_rider_tracking_job")
  @@index([recordedAt], map: "idx_rider_tracking_recorded_at")
}

model DeliveryOffer {
  id                 Int         @id @default(autoincrement())
  jobId              Int         @map("job_id")
  partnerId          Int         @map("partner_id")
  offerStatus        String      @map("offer_status") @db.VarChar(20)
  distanceToPickupKm Decimal?    @map("distance_to_pickup_km") @db.Decimal(8, 3)
  offeredAt          DateTime    @default(now()) @map("offered_at")
  expiresAt          DateTime    @map("expires_at")
  respondedAt        DateTime?   @map("responded_at")
  responseReason     String?     @map("response_reason")
  job                DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partner            Rider       @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "idx_rider_dispatch_offers_job_id")
  @@index([partnerId], map: "idx_rider_dispatch_offers_partner_id")
  @@index([offerStatus, expiresAt], map: "idx_rider_dispatch_offers_status")
}

model VehicleType {
  id             String         @id @default(cuid())
  name           String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vehicleModels  VehicleModel[]

  @@index([name])
}

model VehicleBrand {
  id             String         @id @default(cuid())
  name           String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vehicleModels  VehicleModel[]

  @@index([name])
}

model VehicleModel {
  id               String                @id @default(cuid())
  name             String
  vehicleBrandId   String
  vehicleTypeId    String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  vehicleBrand     VehicleBrand          @relation(fields: [vehicleBrandId], references: [id], onDelete: Cascade)
  vehicleType      VehicleType           @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  products         Product[]
  compatibleProducts Product[]           @relation("ProductCompatibleModels")
  registrations    VehicleRegistration[]

  @@unique([name, vehicleBrandId, vehicleTypeId])
  @@index([vehicleBrandId])
  @@index([vehicleTypeId])
  @@index([name])
}

model VehicleRegistration {
  id             String       @id @default(cuid())
  registrationNumber String     @unique
  vehicleModelId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)

  @@index([registrationNumber])
  @@index([vehicleModelId])
}

enum UserRole {
  CUSTOMER
  SALESMAN
  ADMIN
  RIDER
  DELIVERY_PARTNER
  DELIVERY_PERSON
  SHOP_MANAGER
  // Legacy value kept only so the enum matches the database; new code uses SHOP_MANAGER.
  MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum TransactionType {
  DEPOSIT
  PURCHASE
  SALE_EARNING
  PLATFORM_FEE
  DELIVERY_FEE
  EARNING
  PAYOUT
  REFUND
  COD_PAYMENT
  COD_REMITTANCE
  REFUND_SETTLEMENT
  DEBT_REPAYMENT
}

enum CodSettlementStatus {
  PENDING
  PAID
  NOT_APPLICABLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  REFUND_REQUESTED
  AVAILABLE
  ASSIGNED
  ACCEPTED
  ARRIVED_AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_DROPOFF
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReviewTargetType {
  PRODUCT
  SELLER
  DELIVERY_PARTNER
  CAR_PART
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  HIDDEN
}

enum ItemApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

model DebtReceipt {
  id              String        @id @default(cuid())
  walletId        String
  wallet          Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount          Float
  fileKey         String
  fileType        String
  note            String?
  status          ReceiptStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([walletId])
  @@index([status])
}
